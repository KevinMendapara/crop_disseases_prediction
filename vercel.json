{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/css/(.*)",
      "destination": "/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/js/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://agroshield-backend.onrender.com"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}